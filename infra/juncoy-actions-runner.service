[Unit]
Description=Juncoy GitHub Actions deployment runner
After=network-online.target
Wants=network-online.target
[Service]
WorkingDirectory=/home/junnnnyserver/actions-runner-juncoy
ExecStart=/home/junnnnyserver/actions-runner-juncoy/run.sh
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=300
[Install]
WantedBy=default.target
