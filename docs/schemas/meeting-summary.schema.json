{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "기획",
              "프로그래밍",
              "아트",
              "사운드",
              "QA",
              "운영",
              "기타"
            ]
          },
          "title": {
            "type": "string"
          },
          "discussion": {
            "type": "string"
          },
          "evidence_segment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "category",
          "title",
          "discussion",
          "evidence_segment_ids"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_segment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "decision",
          "reason",
          "evidence_segment_ids"
        ],
        "additionalProperties": false
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          },
          "owner_user_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{1,20}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "due_date_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_segment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "task",
          "owner_user_id",
          "due_date",
          "due_date_text",
          "evidence_segment_ids"
        ],
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "evidence_segment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "question",
          "evidence_segment_ids"
        ],
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "string"
          },
          "impact": {
            "type": [
              "string",
              "null"
            ]
          },
          "mentioned_solution": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_segment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "issue",
          "impact",
          "mentioned_solution",
          "evidence_segment_ids"
        ],
        "additionalProperties": false
      }
    },
    "next_agenda": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agenda": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "enum": [
              "EXPLICIT",
              "DERIVED"
            ]
          },
          "evidence_segment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "agenda",
          "origin",
          "evidence_segment_ids"
        ],
        "additionalProperties": false
      }
    },
    "quality_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "summary",
    "topics",
    "decisions",
    "action_items",
    "open_questions",
    "blockers",
    "next_agenda",
    "quality_notes"
  ],
  "additionalProperties": false
}
