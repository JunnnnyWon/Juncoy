{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary_status": {
      "type": "string",
      "enum": [
        "NOT_REQUESTED",
        "PENDING",
        "RUNNING",
        "READY",
        "STALE",
        "FAILED"
      ]
    },
    "summary_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "transcript_version": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "summary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "topics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "enum": [
                      "기획",
                      "프로그래밍",
                      "아트",
                      "사운드",
                      "QA",
                      "운영",
                      "기타"
                    ]
                  },
                  "title": {
                    "type": "string"
                  },
                  "discussion": {
                    "type": "string"
                  },
                  "evidence_segment_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  }
                },
                "required": [
                  "category",
                  "title",
                  "discussion",
                  "evidence_segment_ids"
                ],
                "additionalProperties": false
              }
            },
            "decisions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "decision": {
                    "type": "string"
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence_segment_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  }
                },
                "required": [
                  "decision",
                  "reason",
                  "evidence_segment_ids"
                ],
                "additionalProperties": false
              }
            },
            "action_items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "task": {
                    "type": "string"
                  },
                  "owner_user_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{1,20}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "due_date": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "due_date_text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence_segment_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  }
                },
                "required": [
                  "task",
                  "owner_user_id",
                  "due_date",
                  "due_date_text",
                  "evidence_segment_ids"
                ],
                "additionalProperties": false
              }
            },
            "open_questions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string"
                  },
                  "evidence_segment_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  }
                },
                "required": [
                  "question",
                  "evidence_segment_ids"
                ],
                "additionalProperties": false
              }
            },
            "blockers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "issue": {
                    "type": "string"
                  },
                  "impact": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mentioned_solution": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence_segment_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  }
                },
                "required": [
                  "issue",
                  "impact",
                  "mentioned_solution",
                  "evidence_segment_ids"
                ],
                "additionalProperties": false
              }
            },
            "next_agenda": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "agenda": {
                    "type": "string"
                  },
                  "origin": {
                    "type": "string",
                    "enum": [
                      "EXPLICIT",
                      "DERIVED"
                    ]
                  },
                  "evidence_segment_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  }
                },
                "required": [
                  "agenda",
                  "origin",
                  "evidence_segment_ids"
                ],
                "additionalProperties": false
              }
            },
            "quality_notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "title",
            "summary",
            "topics",
            "decisions",
            "action_items",
            "open_questions",
            "blockers",
            "next_agenda",
            "quality_notes"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "partial": {
      "type": "boolean"
    },
    "review_status": {
      "type": "string",
      "const": "UNREVIEWED"
    }
  },
  "required": [
    "summary_status",
    "summary_version",
    "transcript_version",
    "result",
    "generated_at",
    "model",
    "partial",
    "review_status"
  ],
  "additionalProperties": false
}
