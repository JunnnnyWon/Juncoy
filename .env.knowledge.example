# 지식(RAG) 파일럿 — .env.knowledge 예시. 실제 값은 .env.knowledge에 둔다 (git 무시).
# 기능 플래그 (spec §16)
KNOWLEDGE_ENABLED=true
DISCORD_CONTEXT_ENABLED=false   # 봇 Message Content Intent 확정 후 true
IMAGE_GENERATION_ENABLED=false  # 이미지 provider 연결 전까지 false (프롬프트 합성만 제공)

# 지식 DB — compose.knowledge.yml의 postgres-knowledge
KNOWLEDGE_POSTGRES_PASSWORD=<변경 필수>
KNOWLEDGE_DATABASE_URL=postgres://knowledge:<동일 비밀번호>@postgres-knowledge:5432/knowledge

# 회의 DB 읽기 전용 role (지식 수집기 전용 — meeting DB에 별도 사용자 생성 필요)
# 예: CREATE ROLE knowledge_ro LOGIN PASSWORD '...'; GRANT CONNECT ON DATABASE meeting TO knowledge_ro;
#     GRANT USAGE ON SCHEMA public TO knowledge_ro; GRANT SELECT ON ALL TABLES IN SCHEMA public TO knowledge_ro;
MEETING_DATABASE_URL=postgres://knowledge_ro:<비밀번호>@postgres:5432/meeting

# LLM/임베딩 — .env.production의 UPSTAGE_API_KEY/UPSTAGE_MODEL 재사용
UPSTAGE_EMBEDDING_QUERY_MODEL=embedding-query
UPSTAGE_EMBEDDING_DOCUMENT_MODEL=embedding-passage

# Discord — DISCORD_CONTEXT_ENABLED=true일 때 필수 (토큰은 .env.production에서 상속)
# DISCORD_BOT_TOKEN=      # .env.production 값 사용
# DISCORD_GUILD_ID=1545264536158740590

# GitHub App 인증 (spec §6.2 — webhook 실시간은 신호, tree 대조가 진실)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=   # PEM 전체, \n으로 줄바꿈 표기
# GITHUB_INSTALLATION_ID=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_REPO=JunnnnyWon/Team_23   # scope metadata.repo 없을 때 기본값

# Notion — 읽기 전용 integration 토큰 (수집기 P5 완료 후 사용)
# NOTION_TOKEN=

# 문답 live 확인 budget ms (§7 기본 12000)
# ANSWER_LIVE_REFRESH_BUDGET_MS=12000

# 로컬 통합 테스트 DB (선택 — 격리된 pgvector 인스턴스):
#   docker run -d -p 127.0.0.1:55440:5432 -e POSTGRES_USER=knowledge -e POSTGRES_PASSWORD=knowledge -e POSTGRES_DB=knowledge pgvector/pgvector:pg17
#   KNOWLEDGE_DATABASE_URL=postgres://knowledge:knowledge@127.0.0.1:55440/knowledge pnpm vitest run tests/integration/
# URL 미설정 시 통합 테스트는 명시적 skip; URL 설정 후 연결/migration 실패는 테스트 실패로 보고된다.
